table DimDate
	dataCategory: Time

	column activity_date
		dataType: dateTime
		formatString: dd/MM/yyyy
		isKey
		summarizeBy: none
		sourceColumn: activity_date

		annotation UnderlyingDateTimeDataType = Date

	column year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: year

	column year_month
		dataType: string
		summarizeBy: none
		sourceColumn: year_month
		sortByColumn: year_month_order

	column year_month_order
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: year_month_order

	partition DimDate = m
		mode: import
		source =
				let
					Today = Date.From(DateTime.LocalNow()),
					StartDate = Date.StartOfYear(Date.AddYears(Today, -2)),
					EndDate = Date.EndOfYear(Date.AddYears(Today, 1)),
					Dates = List.Dates(StartDate, Duration.Days(EndDate - StartDate) + 1, #duration(1, 0, 0, 0)),
					AsTable = Table.FromList(Dates, Splitter.SplitByNothing(), {"activity_date"}),
					TypedDate = Table.TransformColumnTypes(AsTable, {{"activity_date", type date}}),
					AddYear = Table.AddColumn(TypedDate, "year", each Date.Year([activity_date]), Int64.Type),
					AddYearMonth = Table.AddColumn(AddYear, "year_month", each Date.ToText([activity_date], "yyyy-MM"), type text),
					AddOrder = Table.AddColumn(AddYearMonth, "year_month_order", each Date.Year([activity_date]) * 100 + Date.Month([activity_date]), Int64.Type)
				in
					AddOrder
