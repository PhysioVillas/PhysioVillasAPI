table DailyWhatsAppFlowMetrics

	column activity_date
		dataType: dateTime
		formatString: dd/MM/yyyy
		summarizeBy: none
		sourceColumn: activity_date

		annotation UnderlyingDateTimeDataType = Date

	column event_type
		dataType: string
		summarizeBy: none
		sourceColumn: event_type

	column step_key
		dataType: string
		summarizeBy: none
		sourceColumn: step_key

	column source
		dataType: string
		summarizeBy: none
		sourceColumn: source

	column event_count
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: event_count

	column conversation_count
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: conversation_count

	partition DailyWhatsAppFlowMetrics = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(NeonServer, NeonDatabase),
					ReportingView = Source{[Schema = "reporting", Item = "daily_whatsapp_flow_metrics"]}[Data],
					TypedColumns = Table.TransformColumnTypes(ReportingView, {{"activity_date", type date}, {"event_type", type text}, {"step_key", type text}, {"source", type text}, {"event_count", Int64.Type}, {"conversation_count", Int64.Type}})
				in
					TypedColumns
