	partition AppointmentSlotCapacityMetrics = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(NeonServer, NeonDatabase),
					ReportingView = Source{[Schema = "reporting", Item = "appointment_slot_capacity_metrics"]}[Data],
					TypedColumns = Table.TransformColumnTypes(ReportingView, {{"slot_date", type date}, {"slot_time", type time}, {"service_code", type text}, {"service_name", type text}, {"professional_code", type text}, {"professional_name", type text}, {"duration_minutes", Int64.Type}, {"capacity_per_slot", Int64.Type}, {"confirmed_count", Int64.Type}, {"remaining_capacity", Int64.Type}}),
