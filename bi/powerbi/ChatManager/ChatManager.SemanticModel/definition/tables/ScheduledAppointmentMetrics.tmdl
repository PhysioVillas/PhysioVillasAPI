	partition ScheduledAppointmentMetrics = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(NeonServer, NeonDatabase),
					ReportingView = Source{[Schema = "reporting", Item = "scheduled_appointment_metrics"]}[Data],
					TypedColumns = Table.TransformColumnTypes(ReportingView, {{"scheduled_date", type date}, {"scheduled_time", type time}, {"scheduled_end_time", type time}, {"status", type text}, {"attendance_status", type text}, {"service_code", type text}, {"service_name", type text}, {"professional_code", type text}, {"professional_name", type text}, {"appointment_count", Int64.Type}}),
					FormattedTimes = Table.TransformColumns(TypedColumns, {{"scheduled_time", each Time.ToText(_, "HH:mm"), type text}, {"scheduled_end_time", each Time.ToText(_, "HH:mm"), type text}})
				in
					FormattedTimes

	annotation PBI_ResultType = Table
