table DailyMessageMetrics

	column activity_date
		dataType: dateTime
		formatString: dd/MM/yyyy
		summarizeBy: none
		sourceColumn: activity_date

		annotation UnderlyingDateTimeDataType = Date

	column direction
		dataType: string
		summarizeBy: none
		sourceColumn: direction

	column sent_via
		dataType: string
		summarizeBy: none
		sourceColumn: sent_via

	column message_type
		dataType: string
		summarizeBy: none
		sourceColumn: message_type

	column status
		dataType: string
		summarizeBy: none
		sourceColumn: status

	column message_count
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: message_count

	column error_count
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: error_count

	partition DailyMessageMetrics = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(NeonServer, NeonDatabase),
					ReportingView = Source{[Schema = "reporting", Item = "daily_message_metrics"]}[Data],
					TypedColumns = Table.TransformColumnTypes(ReportingView, {{"activity_date", type date}, {"direction", type text}, {"sent_via", type text}, {"message_type", type text}, {"status", type text}, {"message_count", Int64.Type}, {"error_count", Int64.Type}})
				in
					TypedColumns
