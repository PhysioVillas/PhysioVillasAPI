table _Medidas
	lineageTag: 483729d7-2803-4cab-b359-c95a06125d6d

	measure Mensagens = SUM ( DailyMessageMetrics[message_count] )
		formatString: #,0
		lineageTag: 96a2e270-ce42-48fb-8469-dd9e479cfa53

	measure 'Mensagens recebidas' = CALCULATE ( [Mensagens], DailyMessageMetrics[direction] = "in" )
		formatString: #,0
		lineageTag: c601eafb-608b-4330-9a77-aa087652a730

	measure 'Mensagens enviadas' = CALCULATE ( [Mensagens], DailyMessageMetrics[direction] = "out" )
		formatString: #,0
		lineageTag: ea1788c3-ebe6-4c0d-8e24-989f2bc0d721

	measure 'Mensagens com erro' = CALCULATE ( SUM ( DailyMessageMetrics[error_count] ), DailyMessageMetrics[direction] = "out" )
		formatString: #,0
		lineageTag: 56960d0c-d8ce-4564-bf29-de708e822925

	measure 'Taxa de erro de envio' = DIVIDE ( [Mensagens com erro], [Mensagens enviadas] )
		formatString: 0.0%
		lineageTag: 498be8ee-2e0f-4c61-9a6f-11539ef841f5

	measure 'Eventos de fluxo' = COALESCE ( SUM ( DailyWhatsAppFlowMetrics[event_count] ), 0 )
		formatString: #,0
		lineageTag: c333c655-f425-434e-8ea5-531212063d50

	measure 'Mensagens recebidas no fluxo' = COALESCE ( CALCULATE ( [Eventos de fluxo], DailyWhatsAppFlowMetrics[event_type] = "message_received" ), 0 )
		formatString: #,0
		lineageTag: 1dd7104d-a061-4056-9b74-05becbc9336d

	measure 'Opções do menu selecionadas' = COALESCE ( CALCULATE ( [Eventos de fluxo], DailyWhatsAppFlowMetrics[event_type] = "flow_option_selected" ), 0 )
		formatString: #,0
		lineageTag: 7f3ef440-9750-4d2c-8022-c347a9a05e97

	measure 'Seleções em Agendar/Remarcar' = COALESCE ( CALCULATE ( [Opções do menu selecionadas], DailyWhatsAppFlowMetrics[step_key] = "menu_agendar" ), 0 )
		formatString: #,0
		lineageTag: e1a8d54a-bf39-4061-bd60-ab74a4934582

	measure 'Respostas automáticas observadas' = COALESCE ( CALCULATE ( [Eventos de fluxo], DailyWhatsAppFlowMetrics[event_type] = "bot_step_sent" ), 0 )
		formatString: #,0
		lineageTag: 4d103210-300a-42b2-82a2-8f6001e320da

	measure 'Encaminhamentos enviados pelo bot' = COALESCE ( CALCULATE ( [Eventos de fluxo], DailyWhatsAppFlowMetrics[event_type] = "bot_step_sent", DailyWhatsAppFlowMetrics[step_key] = "faq_handoff" ), 0 )
		formatString: #,0
		lineageTag: bb61a71a-f79b-431e-933c-deff01d15086

	measure 'Respostas da equipe observadas' = COALESCE ( CALCULATE ( [Eventos de fluxo], DailyWhatsAppFlowMetrics[event_type] = "team_message_sent" ), 0 )
		formatString: #,0
		lineageTag: 38275b0e-e30a-445f-b322-776d16d4e2e2

	measure 'Seleções com encaminhamento à equipe' = COALESCE ( CALCULATE ( [Opções do menu selecionadas], DailyWhatsAppFlowMetrics[step_key] IN { "menu_agendar", "menu_paciente_novo", "menu_atendente", "btn_atendente" } ), 0 )
		formatString: #,0
		lineageTag: cff24b19-41f7-49e8-a535-01d0e72041a1

	measure 'Respostas humanas com tempo medido' = COALESCE ( SUM ( DailyHumanResponseMetrics[response_count] ), 0 )
		formatString: #,0
		lineageTag: d4a9dd9f-313f-44a7-85b9-0c5d97f265c1

	measure 'Tempo médio até primeira resposta humana (min)' = DIVIDE ( SUMX ( DailyHumanResponseMetrics, DailyHumanResponseMetrics[average_response_seconds] * DailyHumanResponseMetrics[response_count] ), SUM ( DailyHumanResponseMetrics[response_count] ) * 60 )
		formatString: 0.0
		lineageTag: 97811b56-f953-4d29-b0b1-f7187c3fb7a1

	measure 'Pedidos de agendamento pendentes' = COALESCE ( CALCULATE ( SUM ( AppointmentRequestStatusMetrics[request_count] ), AppointmentRequestStatusMetrics[status] = "requested" ), 0 )
		formatString: #,0
		lineageTag: 78ddccd5-26af-48fb-8014-7ee074f947ad

	measure 'Consultas confirmadas' = COALESCE ( CALCULATE ( SUM ( ScheduledAppointmentMetrics[appointment_count] ), ScheduledAppointmentMetrics[status] = "confirmed" ), 0 )
		formatString: #,0
		lineageTag: 7ec64c0b-4cba-4aa5-b055-0c39f845c1cc

	measure 'Consultas canceladas' = COALESCE ( CALCULATE ( SUM ( ScheduledAppointmentMetrics[appointment_count] ), ScheduledAppointmentMetrics[status] = "cancelled" ), 0 )
		formatString: #,0
		lineageTag: 239243e4-310b-4b30-9ab5-527bac0406b1

	measure 'Cancelamentos registrados' = COALESCE ( CALCULATE ( SUM ( DailyAppointmentEventMetrics[event_count] ), DailyAppointmentEventMetrics[event_type] = "cancelled" ), 0 )
		formatString: #,0
		lineageTag: 6a3d4a21-dcbd-468a-beb7-0f4590ba2e76

	measure 'Consultas atendidas' = COALESCE ( CALCULATE ( [Consultas confirmadas], ScheduledAppointmentMetrics[attendance_status] = "attended" ), 0 )
		formatString: #,0
		lineageTag: b8246863-03d5-4da6-8307-772ac35995c5

	measure 'Horários com vaga nos próximos 30 dias' =
			VAR AgoraBahia = UTCNOW () - TIME ( 3, 0, 0 )
			RETURN
			    COALESCE (
			        COUNTROWS (
			            FILTER (
			                AppointmentSlotCapacityMetrics,
			                AppointmentSlotCapacityMetrics[remaining_capacity] > 0
			                    && AppointmentSlotCapacityMetrics[slot_date]
			                        + TIMEVALUE ( AppointmentSlotCapacityMetrics[slot_time] ) > AgoraBahia
			                    && AppointmentSlotCapacityMetrics[slot_date] <= INT ( AgoraBahia ) + 30
			            )
			        ),
			        0
			    )
		formatString: #,0
		lineageTag: 0d0442e4-5cdf-48d7-99c9-e68bb2f3ba68

	measure 'Taxa de ocupação da agenda' = DIVIDE ( SUM ( AppointmentSlotCapacityMetrics[confirmed_count] ), SUM ( AppointmentSlotCapacityMetrics[capacity_per_slot] ) )
		formatString: 0.0%
		lineageTag: 39b01abe-90c2-43bb-ac47-f8fbfe6615a0


	column Coluna
		dataType: string
		isHidden
		lineageTag: 67122ea1-6690-4b2f-8158-390dbf372182
		summarizeBy: none
		sourceColumn: [Coluna]

	partition _Medidas = calculated
		mode: import
		source = ROW ( "Coluna", BLANK () )
