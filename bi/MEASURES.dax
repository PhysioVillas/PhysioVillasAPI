-- Tabela: DailyMessageMetrics
Mensagens = SUM ( DailyMessageMetrics[message_count] )

Mensagens recebidas =
CALCULATE ( [Mensagens], DailyMessageMetrics[direction] = "in" )

Mensagens enviadas =
CALCULATE ( [Mensagens], DailyMessageMetrics[direction] = "out" )

Mensagens com erro =
CALCULATE (
    SUM ( DailyMessageMetrics[error_count] ),
    DailyMessageMetrics[direction] = "out"
)

Taxa de erro de envio = DIVIDE ( [Mensagens com erro], [Mensagens enviadas] )

-- Tabela: DailyWhatsAppFlowMetrics
Eventos de fluxo = COALESCE ( SUM ( DailyWhatsAppFlowMetrics[event_count] ), 0 )

Mensagens recebidas no fluxo =
COALESCE ( CALCULATE (
    [Eventos de fluxo],
    DailyWhatsAppFlowMetrics[event_type] = "message_received"
), 0 )

Conversas com mensagem recebida =
COALESCE ( CALCULATE (
    SUM ( DailyWhatsAppFlowMetrics[conversation_count] ),
    DailyWhatsAppFlowMetrics[event_type] = "message_received"
), 0 )

Opções do menu selecionadas =
COALESCE ( CALCULATE (
    [Eventos de fluxo],
    DailyWhatsAppFlowMetrics[event_type] = "flow_option_selected"
), 0 )

Seleções em Agendar/Remarcar =
COALESCE (
    CALCULATE (
        [Opções do menu selecionadas],
        DailyWhatsAppFlowMetrics[step_key] = "menu_agendar"
    ),
    0
)

Seleções com encaminhamento à equipe =
COALESCE ( CALCULATE ( [Opções do menu selecionadas], DailyWhatsAppFlowMetrics[step_key] IN { "menu_agendar", "menu_paciente_novo", "menu_atendente", "btn_atendente" } ), 0 )

Encaminhamentos enviados pelo bot =
COALESCE ( CALCULATE (
    [Eventos de fluxo],
    DailyWhatsAppFlowMetrics[event_type] = "bot_step_sent",
    DailyWhatsAppFlowMetrics[step_key] = "faq_handoff"
), 0 )

Respostas automáticas observadas =
COALESCE ( CALCULATE (
    [Eventos de fluxo],
    DailyWhatsAppFlowMetrics[event_type] = "bot_step_sent"
), 0 )

Respostas da equipe observadas =
COALESCE ( CALCULATE (
    [Eventos de fluxo],
    DailyWhatsAppFlowMetrics[event_type] = "team_message_sent"
), 0 )

-- Tabela: DailyHumanResponseMetrics
Respostas humanas com tempo medido =
COALESCE ( SUM ( DailyHumanResponseMetrics[response_count] ), 0 )

Tempo médio até primeira resposta humana (min) =
DIVIDE (
    SUMX (
        DailyHumanResponseMetrics,
        DailyHumanResponseMetrics[average_response_seconds]
            * DailyHumanResponseMetrics[response_count]
    ),
    SUM ( DailyHumanResponseMetrics[response_count] ) * 60
)

-- Tabela: AppointmentRequestStatusMetrics e ScheduledAppointmentMetrics
Pedidos de agendamento pendentes =
COALESCE ( CALCULATE ( SUM ( AppointmentRequestStatusMetrics[request_count] ), AppointmentRequestStatusMetrics[status] = "requested" ), 0 )

Consultas confirmadas =
COALESCE ( CALCULATE ( SUM ( ScheduledAppointmentMetrics[appointment_count] ), ScheduledAppointmentMetrics[status] = "confirmed" ), 0 )

Consultas canceladas =
COALESCE ( CALCULATE ( SUM ( ScheduledAppointmentMetrics[appointment_count] ), ScheduledAppointmentMetrics[status] = "cancelled" ), 0 )

Consultas atendidas =
COALESCE ( CALCULATE ( [Consultas confirmadas], ScheduledAppointmentMetrics[attendance_status] = "attended" ), 0 )

Cancelamentos registrados =
COALESCE ( CALCULATE ( SUM ( DailyAppointmentEventMetrics[event_count] ), DailyAppointmentEventMetrics[event_type] = "cancelled" ), 0 )
